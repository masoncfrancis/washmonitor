# Select the existing appliance slot this worker replaces.
APPLIANCE_ROLE=washer

API_SERVER_URL=http://localhost:8001
SHELLY_URL=http://192.168.1.50
SHELLY_USERNAME=
SHELLY_PASSWORD=

# Readings at or above the active threshold are running, in amps.
# Readings at or below the inactive threshold are finished/inactive, in amps.
CURRENT_ACTIVE_THRESHOLD_A=0.5
CURRENT_INACTIVE_THRESHOLD_A=0.1
CURRENT_INACTIVE_DURATION_SECONDS=300
SHELLY_POLL_INTERVAL_SECONDS=5
HTTP_TIMEOUT_SECONDS=10

CONFIG_PATH=/config/config.json
LISTEN_ADDR=:8005
SEND_SMS_URL=https://your_sms_webhook_url
SMS_USER=your_sms_username
SMS_PASSWORD=your_sms_password
